    "stdout_excerpt": "COUNTERFACT_JSON={\"expected\": {\"invalid\": [], \"missing\": [], \"refusal_class\": \"DeribitProviderError\", \"refusal_code\": \"DERIBIT_BAD_CHART_RESPONSE\", \"rejected\": [], \"status\": null}, \"observed\": {\"invalid\": [], \"missing\": [], \"refusal_class\": \"DeribitProviderError\", \"refusal_code\": \"DERIBIT_BAD_CHART_RESPONSE\", \"rejected\": [], \"status\": null}, \"reason\": \"a close array that carries a numeric string keeps the tick, the open/high/low and the volume arrays exactly as long, so the length guards pass and only the reader of close notices: close is a required column of DeribitFuturesHistorical and the candle fetcher must refuse the chart rather than coerce the cell to a float it never parsed or publish a bar with no close. The break is in the second of the two chart replies, so the first instrument's candle is served whole and the refusal is the fetcher's, not a fixture that never worked; untampered control produced 2 row(s) through the same seam\"}\nVERDICT=PASS\n"
