diff --git a/scripts/quality/iter2_witnesses/seeking_alpha.py b/scripts/quality/iter2_witnesses/seeking_alpha.py
index 165eb7cc9..4d9dde5cc 100644
--- a/scripts/quality/iter2_witnesses/seeking_alpha.py
+++ b/scripts/quality/iter2_witnesses/seeking_alpha.py
@@ -83,6 +83,87 @@ def _cboe_calendar_envelope() -> dict[str, Any]:
     }
 
 
+_SA_ID = "1150"
+_SA_EFFECTIVE = "2024-06-19T00:06:03.000-04:00"
+
