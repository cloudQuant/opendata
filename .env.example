# opendata configuration template.
# Copy to `.env` and fill in every value marked REQUIRED. `.env` is gitignored;
# never commit real credentials.

# Application Settings
APP_NAME=opendata
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Server Settings
HOST=0.0.0.0
PORT=8000
# Optional absolute path to the server-owned source policy JSON; unset or empty disables grants.
# PROVIDER_SOURCE_POLICY_FILE=/etc/opendata/source-policy.json
# Single-process deployment only (decision D8); multi-worker is out of scope.
WORKERS=1

# Metadata database (users, tasks, executions, data catalog)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=opendata_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=opendata

# Data warehouse database (ods_* / dwd_* / dq_diff_report)
DATA_MYSQL_HOST=127.0.0.1
DATA_MYSQL_PORT=3306
DATA_MYSQL_USER=opendata_user
DATA_MYSQL_PASSWORD=change-me
DATA_MYSQL_DATABASE=opendata_data

# docker-compose only: root passwords and the warehouse user.
# REQUIRED when running `docker compose up` — the compose file refuses to start
# without them so weak defaults can never reach a deployment.
MYSQL_ROOT_PASSWORD=change-me
WAREHOUSE_ROOT_PASSWORD=change-me
WAREHOUSE_USER=opendata_user
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_DATABASE=opendata_data
# SECRET_KEY is also REQUIRED by docker-compose; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret

# Database Connection Pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Settings (optional, for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Authentication Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Email Settings (for verification and data-quality alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@opendata.com
EMAILS_FROM_NAME=opendata

# Task Scheduler Settings
# Consumer API keys (design §10.3): the pepper is mixed into every stored
# key hash; replace this placeholder with a random value before deployment.
# If unset, hashing falls back to SECRET_KEY. The failure delay flattens the
# timing signal of rejected keys.
API_KEY_PEPPER=replace-with-random-secret-before-deploy
API_KEY_FAILURE_DELAY_SECONDS=0.05

# Retention (design §8.5/§13): raw-response cache root + TTL, diff report
# aggregate window, minute-line archive window. Daily bars, financials and
# metadata are permanent and are refused by every purge path.
# Raw-response caching is disabled unless explicitly enabled.
RAW_RESPONSE_CACHE_ENABLED=false
# CACHE_DIR also accepts OPENDATA_CACHE_DIR as a compatibility alias.
# CACHE_DIR=/path/to/opendata-cache
# OPENDATA_CACHE_DIR=/path/to/opendata-cache
CACHE_TTL_SECONDS=900
RETENTION_DIFF_REPORT_DAYS=90
RETENTION_MINUTE_YEARS=10
# Scheduled retention starts in report-only mode. Set true only after reviewing
# candidate counts and confirming backups/restore procedures for these targets.
RETENTION_EXECUTION_ENABLED=false

# Optional issuer-provided key expiry metadata. Omitted dates remain unknown;
# this does not probe validity or remaining quota.
# FUYAO_API_KEY_EXPIRES_AT=YYYY-MM-DD
# FRED_API_KEY_EXPIRES_AT=YYYY-MM-DD
KEY_EXPIRY_WARNING_DAYS=14
KEY_HEALTH_OBSERVATION_TTL_HOURS=24
# JSON list. Empty means WebSocket notifications only; SMTP requires recipients.
KEY_HEALTH_NOTIFICATION_EMAILS=[]

# Explicit scheduler ownership (design §9.3). Production MUST set this;
# run exactly one scheduler owner or point it at Redis-backed storage.
ENABLE_SCHEDULER=true
SCHEDULER_BOOTSTRAP_ON_STARTUP=true
SCHEDULER_MAX_WORKERS=3
# Scheduled P0 provider probes are opt-in. Threshold state is persisted under DATA_DIR.
PATROL_ENABLED=false
PATROL_FAILURE_ALERT_THRESHOLD=2
TASK_RETRY_MAX_ATTEMPTS=3
TASK_RETRY_BASE_DELAY=60

# Optional daily logical backup Compose profile. It runs only when explicitly
# started with `docker compose --profile backup up -d`.
BACKUP_RETENTION_DAYS=30
# Set backup-only, per-database accounts after granting the privileges listed
# in docs/operations-backup-restore.md. Blank/unset values fall back to app
# accounts, which do not automatically have mysqldump's global privileges.
# BACKUP_MYSQL_USER=opendata_backup
# BACKUP_MYSQL_PASSWORD=change-me
# BACKUP_DATA_MYSQL_USER=opendata_warehouse_backup
# BACKUP_DATA_MYSQL_PASSWORD=change-me
# BACKUP_DIR=/mnt/opendata-backups
# BACKUP_ENV_FILE=  # empty skips dotenv loading; unset reads this project .env
# Compose pairs these dumps with ./data/minute_archive using a verified tar
# manifest before atomically publishing a snapshot directory.
# BACKUP_MINUTE_ARCHIVE_DIR=/data/minute_archive
# BACKUP_PYTHON=python3

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:6600"]
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# Set to true for structured JSON logs (recommended for production log aggregators)
LOG_JSON=false

# Error Tracking (Sentry) - optional
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Admin default password (set before first startup, or a random one is generated)
# ADMIN_DEFAULT_PASSWORD=your-secure-admin-password

# Data Storage
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Vendored HTTP data-source client (formerly akshare) request settings
AKSHARE_TIMEOUT=120
AKSHARE_CALL_TIMEOUT=120
AKSHARE_RETRY_ATTEMPTS=3

# Tonghuashun Fuyao API (authoritative domestic source, milestone A3)
# Missing key: the source is skipped by the router with an explicit alert.
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# Xueqiu token (optional, used by the Xueqiu-based interfaces)
XQ_A_TOKEN=
